# Configuracion de desarrollo para Docker Compose. Copiar a .env en la raiz.
# La API carga sus secretos y credenciales desde services/api/.env.
# Conservar SECRET_KEY, ADMIN_EMAIL y ADMIN_PASSWORD reales solo en ese archivo.

ENVIRONMENT=development
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
FRONTEND_URL=http://localhost:3002
# Obligatoria en .env: usar la conexion PostgreSQL de Supabase con sslmode=require.
# Codificar los caracteres especiales de la contrasena en la URL. Nunca commitearla.
SUPABASE_DATABASE_URL=
PYTHON_DOTENV_DISABLED=1
WATCHFILES_FORCE_POLLING=true
UV_PROJECT_ENVIRONMENT=/opt/venv

INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_INCIDENTS_API_URL=/_nexova-api
NEXT_PUBLIC_TELEMETRY_ENDPOINT=/_nexova-api/telemetry/events
NEXT_PUBLIC_API_URL=https://playground.4geeks.com/tracker/api/v1
NEXT_PUBLIC_APPLICATION_URL=http://localhost:3002
NEXT_TELEMETRY_DISABLED=1
NEXT_DOCKER_POLLING=1
