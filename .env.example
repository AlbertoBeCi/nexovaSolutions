# Valores exclusivamente locales para docker compose. No usar en despliegues.
POSTGRES_DB=nexova
POSTGRES_USER=nexova
POSTGRES_PASSWORD=nexova-local

SECRET_KEY=local-development-only-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=15
ADMIN_EMAIL=admin@nexova.local
ADMIN_PASSWORD=Admin123!
ENVIRONMENT=development
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nexova <onboarding@resend.dev>
FRONTEND_URL=http://localhost:3002
SUPPLIERS_DB_PATH=/data/suppliers.json
USERS_DB_PATH=/data/users.json
SUPABASE_DATABASE_URL=postgresql://nexova:nexova-local@postgres:5432/nexova
PYTHON_DOTENV_DISABLED=1
WATCHFILES_FORCE_POLLING=true
UV_PROJECT_ENVIRONMENT=/opt/venv

INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_INCIDENTS_API_URL=/_nexova-api
NEXT_PUBLIC_API_URL=https://playground.4geeks.com/tracker/api/v1
NEXT_PUBLIC_APPLICATION_URL=http://localhost:3002
NEXT_TELEMETRY_DISABLED=1
NEXT_DOCKER_POLLING=1
