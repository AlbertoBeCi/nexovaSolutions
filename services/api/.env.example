# Copia este fichero a .env y completa los valores reales. .env nunca se commitea
# (ver services/api/.gitignore).

# Firma de los JWT. Obligatoria en produccion; en desarrollo hay un valor por
# defecto (con warning en el log) si se omite.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Algoritmo de firma del JWT.
ALGORITHM=HS256

# Minutos de validez del access token.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Minutos de validez de un token de reset de password (POST /auth/forgot-password).
PASSWORD_RESET_EXPIRE_MINUTES=15

# Credenciales del primer admin, usadas por `uv run seed-users`.
ADMIN_EMAIL=admin@nexova.com
ADMIN_PASSWORD=cambia-esto-por-una-contrasena-segura

# "development" (por defecto) o "production". En production, si no se pudo
# enviar el email de forgot-password (sin RESEND_API_KEY o Resend fallo), el
# token de reset NUNCA se loguea en claro; en development si, para poder
# probar el flujo sin cuenta de Resend.
ENVIRONMENT=development

# Envio de emails (mailer.py, POST /auth/forgot-password). Sin RESEND_API_KEY,
# forgot-password sigue funcionando: loguea el token por consola en vez de
# enviarlo. RESEND_FROM_EMAIL por defecto usa el remitente de pruebas de
# Resend (onboarding@resend.dev): solo entrega al email con el que creaste
# la cuenta de Resend, mientras no verifiques un dominio propio.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nexova <onboarding@resend.dev>

# Base del frontend para construir el link de /reset-password?token=... en
# el email (y en el log de consola si no hay RESEND_API_KEY).
FRONTEND_URL=http://localhost:3001

# Ya existian (ver database.py / main.py):
# SUPPLIERS_DB_PATH=services/api/data/suppliers.json
# USERS_DB_PATH=services/api/data/users.json
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
