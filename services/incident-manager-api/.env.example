# Copia este fichero a .env y ajusta los valores si hace falta. .env nunca
# se commitea (ver .gitignore).

# URL de conexion de SQLAlchemy. Por defecto, un archivo SQLite en
# services/incident-manager-api/data/incidents.db (creado automaticamente,
# ignorado por git).
INCIDENTS_DATABASE_URL=sqlite:///./data/incidents.db

# Host/puerto de `uv run serve`. 8001 para no chocar con services/api (8000).
API_HOST=0.0.0.0
API_PORT=8001

# Origenes permitidos por CORS, separados por comas. Por defecto, los
# frontends de desarrollo: uis/backoffice (3000) y uis/application (3001).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
